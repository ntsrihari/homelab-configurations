# Copy to .env and fill in real values. See README-immich.md.
UPLOAD_LOCATION=I:/ImmichData
EXTERNAL_LIBRARY=I:/Photos
TZ=Asia/Kolkata
IMMICH_VERSION=v3.1.0

# Generate a strong A-Za-z0-9 password (no symbols). KEEP IT SAFE.
DB_PASSWORD=CHANGE_ME_strong_alphanumeric

DB_USERNAME=postgres
DB_DATABASE_NAME=immich
